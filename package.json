{
  "name": "new-world-crafting-calculator",
  "version": "2.0.2",
  "description": "A comprehensive crafting calculator for Amazon's New World MMO with advanced OCR inventory detection, customizable hotkeys, persistent configuration system, and interactive crafting tree visualization.",
  "author": "Involvex",
  "homepage": "https://involvex.github.io/newworld-dailycraft-calc/",
  "sponsor": {
    "url": "https://github.com/sponsors/involvex"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/involvex/newworld-dailycraft-calc.git"
  },
  "keywords": [
    "new-world",
    "mmo",
    "crafting",
    "calculator",
    "gaming",
    "ocr",
    "electron",
    "typescript",
    "react",
    "configuration",
    "hotkeys",
    "presets"
  ],
  "main": "electron.js",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:electron": "vite build --mode electron",
    "build:electron:prod": "cross-env NODE_ENV=production vite build --mode electron",
    "build:pages": "cross-env VITE_BASE_URL=/newworld-dailycraft-calc/ vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"bun:dev\" \"bun:start-electron-dev\"",
    "start:electron:dev": "wait-on http://localhost:3000 && cross-env NODE_ENV=development \"node_modules/.bin/electron\" electron.js",
    "electron": "bun run build:electron && bunx electron electron.js",
    "electron:prod": "bun run build:electron:prod && cross-env NODE_ENV=production bunx electron electron.js",
    "dist": "bun run build:electron:prod && cross-env NODE_ENV=production bunx electron-builder --config.compression=maximum --config.win.target=portable",
    "deploy": "bun run build:pages && copy dist\\index.html docs\\index.html && xcopy dist\\assets docs\\assets /E /I /Y",
    "build:prod": "powershell -ExecutionPolicy Bypass -File .\\build-prod.ps1",
    "push-pages": "bun run deploy && git add docs/ && git commit -m \"Deploy to GitHub Pages\" && git push origin main",
    "serve": "bun run build && bun simple-server.js",
    "portable": "bun run build:electron && bun build-portable.js",
    "build:all": "bun build-all.js",
    "build:web": "bun build-web-only.js",
    "lint": "bunx eslint . --config eslint.config.mjs",
    "lint:fix": "bunx eslint . --config eslint.config.mjs --fix",
    "format": "bunx prettier . --config .prettierrc.yaml --write",
    "format:check": "bunx prettier . --config .prettierrc.yaml --check",
    "release": "bun run format && bun run lint:fix && bun run build:all && git add . &&  git tag -a $npm_package_version && git commit -m \"Release v$npm_package_version\" && git push origin main --follow-tags",
    "typecheck": "tsc --noEmit",
    "prebuild": "bun run format && bun run lint:fix && bun run typecheck"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cloneable-readable": "^3.0.0",
    "core-util-is": "^1.0.3",
    "globals": "^16.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/css": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.2.1",
    "electron-builder": "^26.8.1",
    "eslint-plugin-react": "^7.37.5",
    "generate": "^0.14.0",
    "generate-eslint": "^1.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.involvex.newworld-calculator",
    "productName": "New World Crafting Calculator",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron.js",
      "preload.js",
      "logo.png",
      "services/**/*",
      "dist/**/*",
      "!dist/**/*.map",
      "fokusnewworldscreenshot.ps1"
    ],
    "icon": "logo.png",
    "compression": "maximum",
    "win": {
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      "icon": "logo.png",
      "forceCodeSigning": false
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs",
    "tesseract.js"
  ]
}
